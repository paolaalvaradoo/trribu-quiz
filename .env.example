# Copiar a Vercel › Settings › Environment Variables. NUNCA subir valores reales al repo.
QUIZ_MODO=prelanzamiento                 # prelanzamiento | lanzamiento (cambiar el 16-nov)
ALLOWED_ORIGINS=https://trribu.com,https://www.trribu.com
SHOPIFY_STORE_URL=https://trribu.com
PRIVACY_POLICY_URL=                      # PENDIENTE (PREGUNTAS_PARA_PAO.md #5)

KLAVIYO_PRIVATE_API_KEY=                 # pk_… con permisos: profiles:write, events:write, subscriptions:write, lists:write
KLAVIYO_REVISION=2025-10-15              # verificar la revisión vigente en developers.klaviyo.com
KLAVIYO_LIST_ESPERA=                     # «TRRIBÚ · Lista de espera»
KLAVIYO_LIST_NEWSLETTER=                 # «TRRIBÚ · Newsletter» (lanzamiento)
KLAVIYO_LIST_WHATSAPP=                   # «TRRIBÚ · WhatsApp» (opcional mientras se define el canal)
KLAVIYO_LIST_PANEL=                      # «TRRIBÚ · Panel de pruebas»

AIRTABLE_TOKEN=                          # Personal Access Token solo para la base «TRRIBÚ · Quiz» (data.records:read + write)
AIRTABLE_BASE_ID=                        # app…
AIRTABLE_TABLE=Respuestas

CRON_SECRET=                             # texto largo al azar; Vercel lo manda al cron de reintento
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000
